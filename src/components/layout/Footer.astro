---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-[color-mix(in_srgb,var(--color-sea-deep)_92%,black)] py-8 pb-10 text-[#d7e4e7]">
	<div
		class="mx-auto grid w-[min(100%-2rem,72rem)] gap-3 min-[720px]:grid-cols-[1fr_auto_auto] min-[720px]:items-center min-[720px]:gap-6"
	>
		<p class="m-0 inline-flex items-center gap-2 font-display font-extrabold tracking-tight">
			<i class="las la-layer-group" aria-hidden="true"></i>
			Astro Svelte
		</p>
		<p class="m-0 text-[0.95rem] text-[#d7e4e7]/75">
			© {year} · Built with Astro islands and Svelte
		</p>
		<nav class="flex gap-5" aria-label="Footer">
			<a
				href="https://docs.astro.build"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-[#d7e4e7] no-underline hover:underline"
			>
				<i class="las la-book" aria-hidden="true"></i>
				Astro docs
			</a>
			<a
				href="https://svelte.dev/docs/svelte/getting-started"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-[#d7e4e7] no-underline hover:underline"
			>
				<i class="las la-code" aria-hidden="true"></i>
				Svelte docs
			</a>
		</nav>
	</div>
</footer>
