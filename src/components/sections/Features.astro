---
const features = [
	{
		title: 'Astro pages',
		body: 'Ship HTML by default from .astro files — layouts, slots, and zero JS until you ask for it.',
	},
	{
		title: 'Svelte islands',
		body: 'Drop interactive .svelte components where you need them, hydrated with client directives.',
	},
	{
		title: 'Clear structure',
		body: 'pages/, components/, and layouts/ stay predictable so the site grows without chaos.',
	},
];
---

<section id="features" class="py-[clamp(3.5rem,8vw,6rem)]" aria-labelledby="features-title">
	<div class="mx-auto w-[min(100%-2rem,72rem)]">
		<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
			Features
		</p>
		<h2
			id="features-title"
			class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
		>
			What this stack is for
		</h2>
		<p class="m-0 max-w-xl text-lg text-ink-soft">
			Keep most of the UI static. Hydrate only the pieces that need client-side state.
		</p>

		<ul class="mt-10 grid list-none gap-7 p-0 min-[800px]:grid-cols-3 min-[800px]:gap-8">
			{
				features.map((feature, index) => (
					<li
						class="border-t border-line pt-4 [animation:rise_650ms_ease_both]"
						style={`animation-delay: ${index * 120 + 80}ms`}
					>
						<h3 class="mb-2 font-display text-[1.2rem] font-bold tracking-tight text-ink">
							{feature.title}
						</h3>
						<p class="m-0 text-ink-soft">{feature.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
