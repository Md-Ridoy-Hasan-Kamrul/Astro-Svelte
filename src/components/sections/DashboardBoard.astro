---
/**
 * Crextio dashboard home board — chrome lives in DashboardLayout.
 */
import SidebarAccordion from '../islands/dashboard/SidebarAccordion.svelte';
import TimeTracker from '../islands/dashboard/TimeTracker.svelte';
import OnboardingTasks from '../islands/dashboard/OnboardingTasks.svelte';

const weekBars = [
	{ day: 'S', h: 28 },
	{ day: 'M', h: 52 },
	{ day: 'T', h: 40 },
	{ day: 'W', h: 62 },
	{ day: 'T', h: 48 },
	{ day: 'F', h: 78, active: true, tip: '5h 23m' },
	{ day: 'S', h: 34 },
];

const sidebarRows = [
	{ id: 'pension', label: 'Pension contributions' },
	{
		id: 'devices',
		label: 'Devices',
		detail: {
			image: '/dashboard/macbook.jpg',
			title: 'MacBook Air',
			subtitle: 'Version M1',
		},
	},
	{ id: 'compensation', label: 'Compensation Summary' },
	{ id: 'benefits', label: 'Employee Benefits' },
];

const tasks = [
	{ id: '1', title: 'Interview', time: '9:00 am', icon: 'interview' as const, done: true },
	{ id: '2', title: 'Team Meeting', time: '10:00 am', icon: 'team' as const, done: true },
	{ id: '3', title: 'Project Update', time: '11:30 am', icon: 'project' as const, done: false },
	{ id: '4', title: 'Discuss Q3 Goals', time: '1:00 pm', icon: 'goals' as const, done: false },
	{ id: '5', title: 'HR Policy Review', time: '3:15 pm', icon: 'hr' as const, done: false },
];
---

	<!-- Welcome + KPIs -->
	<section class="mb-6 grid gap-5 min-[1100px]:grid-cols-[1.2fr_0.8fr] min-[1100px]:items-end">
		<div>
			<h1 class="mb-5 font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-[#1c1c1c]">
				Welcome in, Nixtio
			</h1>
			<div class="flex flex-wrap gap-2">
				<span
					class="inline-flex min-w-[6.5rem] items-center justify-between gap-3 rounded-full bg-[#1c1c1c] px-3 py-2 text-xs font-medium text-white"
				>
					Interviews <strong class="font-semibold text-[#ffd74b]">15%</strong>
				</span>
				<span
					class="inline-flex min-w-[6.5rem] items-center justify-between gap-3 rounded-full bg-[#ffd74b] px-3 py-2 text-xs font-medium text-[#1c1c1c]"
				>
					Hired <strong class="font-semibold">15%</strong>
				</span>
				<span
					class="cx-stripe inline-flex min-w-[9rem] flex-1 items-center justify-between gap-3 rounded-full px-3 py-2 text-xs font-medium text-[#1c1c1c] min-[700px]:max-w-[16rem]"
				>
					Project time <strong class="font-semibold">60%</strong>
				</span>
				<span
					class="inline-flex min-w-[6rem] items-center justify-between gap-3 rounded-full border border-[#1c1c1c]/18 bg-transparent px-3 py-2 text-xs font-medium text-[#1c1c1c]"
				>
					Output <strong class="font-semibold">10%</strong>
				</span>
			</div>
		</div>

		<div class="flex flex-wrap items-end justify-start gap-6 min-[1100px]:justify-end">
			<div class="flex items-center gap-2.5">
				<span class="grid size-10 place-items-center rounded-full bg-white text-[#1c1c1c] shadow-sm" aria-hidden="true">
					<svg class="size-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
						><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path
							d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
							stroke-linecap="round"></path></svg
					>
				</span>
				<div>
					<p class="m-0 text-2xl font-semibold tracking-tight">78</p>
					<p class="m-0 text-xs text-[#6b6b6b]">Employee</p>
				</div>
			</div>
			<div class="flex items-center gap-2.5">
				<span class="grid size-10 place-items-center rounded-full bg-white text-[#1c1c1c] shadow-sm" aria-hidden="true">
					<svg class="size-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
						><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path
							d="M19 8v6M22 11h-6"
							stroke-linecap="round"></path></svg
					>
				</span>
				<div>
					<p class="m-0 text-2xl font-semibold tracking-tight">56</p>
					<p class="m-0 text-xs text-[#6b6b6b]">Hirings</p>
				</div>
			</div>
			<div class="flex items-center gap-2.5">
				<span class="grid size-10 place-items-center rounded-full bg-white text-[#1c1c1c] shadow-sm" aria-hidden="true">
					<svg class="size-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
						><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M8 21h8M12 18v3" stroke-linecap="round"></path></svg
					>
				</span>
				<div>
					<p class="m-0 text-2xl font-semibold tracking-tight">203</p>
					<p class="m-0 text-xs text-[#6b6b6b]">Projects</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Main grid — matches Crextio Figma areas -->
	<div
		class="grid gap-4 min-[1100px]:grid-cols-[0.95fr_1.05fr_1.05fr_0.95fr] min-[1100px]:grid-rows-[auto_1fr]"
	>
		<!-- Profile -->
		<article
			class="relative overflow-hidden rounded-[1.75rem] bg-white shadow-[0_18px_40px_rgb(28_28_28_/0.06)] min-[1100px]:col-start-1 min-[1100px]:row-start-1"
		>
			<img
				src="/dashboard/lora.jpg"
				alt="Lora Piterson"
				class="aspect-[4/5] w-full object-cover min-[1100px]:aspect-auto min-[1100px]:h-full min-[1100px]:min-h-[22rem]"
				width="640"
				height="800"
			/>
			<div
				class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent p-5 pt-16 text-white"
			>
				<p class="m-0 text-lg font-semibold">Lora Piterson</p>
				<p class="m-0 text-sm text-white/75">UX/UI Designer</p>
			</div>
			<span
				class="absolute bottom-5 right-5 rounded-full border border-white/40 bg-white/85 px-3.5 py-1.5 text-sm font-semibold text-[#1c1c1c] shadow backdrop-blur-sm"
			>
				$1,200
			</span>
		</article>

		<!-- Progress -->
		<article
			class="relative rounded-[1.75rem] bg-white p-5 shadow-[0_18px_40px_rgb(28_28_28_/0.06)] min-[1100px]:col-start-2 min-[1100px]:row-start-1"
		>
			<button
				type="button"
				class="absolute right-4 top-4 grid size-8 place-items-center rounded-full border border-[#e8e4dc] bg-white text-[#1c1c1c]"
				aria-label="Open work time"
			>
				<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
					><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path></svg
				>
			</button>
			<p class="m-0 text-sm font-medium text-[#6b6b6b]">Progress</p>
			<p class="m-0 mt-1 text-[2rem] font-semibold tracking-tight text-[#1c1c1c]">6.1 h</p>
			<p class="mb-5 mt-0.5 text-sm text-[#6b6b6b]">Work Time this week</p>
			<div class="flex h-36 items-end justify-between gap-2.5 px-1">
				{
					weekBars.map((bar) => (
						<div class="relative flex h-full flex-1 flex-col items-center justify-end gap-2">
							{bar.active && bar.tip ? (
								<span class="absolute top-0 z-10 rounded-full bg-[#1c1c1c] px-2 py-0.5 text-[0.65rem] font-medium text-white">
									{bar.tip}
								</span>
							) : null}
							<div
								class:list={[
									'w-full max-w-8 rounded-full',
									bar.active ? 'bg-[#ffd74b]' : 'bg-[#2a2a2a]',
								]}
								style={`height:${bar.h}%`}
							/>
							<span class="text-[0.7rem] text-[#6b6b6b]">{bar.day}</span>
						</div>
					))
				}
			</div>
		</article>

		<!-- Time tracker -->
		<div class="min-[1100px]:col-start-3 min-[1100px]:row-start-1">
			<TimeTracker client:visible />
		</div>

		<!-- Onboarding % -->
		<article
			class="flex flex-col justify-between rounded-[1.75rem] bg-white p-5 shadow-[0_18px_40px_rgb(28_28_28_/0.06)] min-[1100px]:col-start-4 min-[1100px]:row-start-1"
		>
			<div>
				<p class="m-0 text-sm text-[#6b6b6b]">Onboarding</p>
				<p class="mt-1 m-0 text-3xl font-semibold tracking-tight text-[#1c1c1c]">18%</p>
			</div>
			<div class="mt-6">
				<p class="mb-2 text-xs font-medium text-[#6b6b6b]">Task</p>
				<div class="flex h-3 overflow-hidden rounded-full bg-[#ece8e0]">
					<span class="h-full w-[30%] bg-[#ffd74b]"></span>
					<span class="h-full w-[25%] bg-[#1c1c1c]"></span>
					<span class="h-full w-[45%] bg-transparent"></span>
				</div>
				<div class="mt-2 flex justify-between text-[0.65rem] text-[#6b6b6b]">
					<span>30%</span><span>25%</span><span>0%</span>
				</div>
			</div>
		</article>

		<!-- Sidebar accordion -->
		<div
			class="rounded-[1.75rem] bg-white px-4 py-2 shadow-[0_18px_40px_rgb(28_28_28_/0.06)] min-[1100px]:col-start-1 min-[1100px]:row-start-2"
		>
			<SidebarAccordion client:visible rows={sidebarRows} />
		</div>

		<!-- Calendar spans middle two cols -->
		<article
			class="flex flex-col rounded-[1.75rem] bg-white p-5 shadow-[0_18px_40px_rgb(28_28_28_/0.06)] min-[1100px]:col-span-2 min-[1100px]:col-start-2 min-[1100px]:row-start-2"
		>
			<div class="mb-4 flex items-center justify-between gap-3">
				<div>
					<p class="m-0 text-sm font-semibold text-[#1c1c1c]">September 2024</p>
					<p class="m-0 text-xs text-[#6b6b6b]">Week of Mon 22 – Sat 27</p>
				</div>
			</div>
			<div class="mb-3 grid grid-cols-[3rem_repeat(6,1fr)] gap-1 text-center text-[0.7rem] text-[#6b6b6b]">
				<span></span>
				<span>Mon 22</span><span>Tue 23</span><span>Wed 24</span><span>Thu 25</span><span>Fri 26</span
				><span>Sat 27</span>
			</div>
			<div class="relative grid flex-1 grid-cols-[3rem_1fr] gap-2 text-xs text-[#6b6b6b]">
				<div class="flex flex-col justify-between py-1">
					<span>8:00 am</span>
					<span>9:00 am</span>
					<span>10:00 am</span>
					<span>11:00 am</span>
				</div>
				<div class="relative min-h-[14rem] rounded-[1.25rem] bg-[#f7f5ef]">
					<div class="absolute left-[4%] top-[12%] w-[42%] rounded-[1.1rem] bg-[#1c1c1c] p-3 text-white">
						<p class="m-0 text-[0.8rem] font-semibold">Weekly Team Sync</p>
						<p class="m-0 text-[0.65rem] text-white/60">8:30 – 9:30</p>
						<div class="mt-2 flex -space-x-2">
							<span class="size-6 rounded-full border-2 border-[#1c1c1c] bg-[#ffd74b]"></span>
							<span class="size-6 rounded-full border-2 border-[#1c1c1c] bg-[#8ecae6]"></span>
							<span class="size-6 rounded-full border-2 border-[#1c1c1c] bg-[#adb5bd]"></span>
						</div>
					</div>
					<div
						class="absolute bottom-[10%] left-[48%] w-[46%] rounded-[1.1rem] border border-[#e8e4dc] bg-white p-3 text-[#1c1c1c]"
					>
						<p class="m-0 text-[0.8rem] font-semibold">Onboarding Session</p>
						<p class="m-0 text-[0.65rem] text-[#6b6b6b]">10:30 – 11:30</p>
						<div class="mt-2 flex -space-x-2">
							<span class="size-6 rounded-full border-2 border-white bg-[#ffd74b]"></span>
							<span class="size-6 rounded-full border-2 border-white bg-[#adb5bd]"></span>
						</div>
					</div>
				</div>
			</div>
		</article>

		<!-- Onboarding tasks -->
		<div class="min-[1100px]:col-start-4 min-[1100px]:row-start-2">
			<OnboardingTasks client:visible tasks={tasks} />
		</div>
	</div>

<style>
	.cx-stripe {
		background: repeating-linear-gradient(
			-45deg,
			#ece8e0,
			#ece8e0 6px,
			#f7f5ef 6px,
			#f7f5ef 12px
		);
	}
</style>
