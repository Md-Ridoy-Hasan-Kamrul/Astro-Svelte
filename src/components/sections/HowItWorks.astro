---
const steps = [
	{
		label: '01',
		title: 'Compose in Astro',
		body: 'Layouts wrap pages. Components compose the markup. Content stays close to the route.',
	},
	{
		label: '02',
		title: 'Import Svelte',
		body: 'Bring interactive UI from .svelte files the same way you import any component.',
	},
	{
		label: '03',
		title: 'Hydrate on demand',
		body: 'Add client:load for above-the-fold UI. Use client:visible or client:idle for islands lower on the page.',
	},
];
---

<section
	id="how"
	class="border-y border-line bg-foam/55 py-[clamp(3.5rem,8vw,6rem)]"
	aria-labelledby="how-title"
>
	<div
		class="mx-auto grid w-[min(100%-2rem,72rem)] gap-10 min-[900px]:grid-cols-[0.9fr_1.1fr] min-[900px]:items-start min-[900px]:gap-14"
	>
		<div>
			<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
				How it works
			</p>
			<h2
				id="how-title"
				class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
			>
				Same pattern as the docs
			</h2>
			<p class="m-0 max-w-xl text-lg text-ink-soft">
				Astro owns the page shell. Svelte owns interactive islands like a buy button or nav menu —
				hydrated with a client directive.
			</p>
		</div>

		<ol class="m-0 grid list-none gap-6 p-0">
			{
				steps.map((step) => (
					<li class="grid grid-cols-[auto_1fr] items-start gap-4">
						<span class="pt-0.5 font-display text-[0.95rem] font-extrabold tracking-wide text-sea">
							{step.label}
						</span>
						<div>
							<h3 class="mb-1 font-display text-[1.15rem] tracking-tight text-ink">
								{step.title}
							</h3>
							<p class="m-0 text-ink-soft">{step.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
