---
/**
 * Shared Crextio section page — same chrome + themed content cards.
 */
import AuthGate from '../islands/dashboard/AuthGate.svelte';
import DashboardChrome from './DashboardChrome.astro';
import type { DashboardSectionContent } from '../../lib/dashboard/sections';

interface Props {
	section: DashboardSectionContent;
}

const { section } = Astro.props;

function badgeClass(tone: 'dark' | 'yellow' | 'soft' = 'soft') {
	if (tone === 'dark') return 'bg-[#1c1c1c] text-white';
	if (tone === 'yellow') return 'bg-[#ffd74b] text-[#1c1c1c]';
	return 'border border-[#1c1c1c]/15 bg-white text-[#1c1c1c]';
}
---

<AuthGate client:load />

<div class="mx-auto w-[min(100%-1.25rem,78rem)] py-4 md:py-6">
	<DashboardChrome active={section.id} />

	<section class="mb-6">
		<p class="mb-2 font-mono text-sm text-[#6b6b6b]">{section.index}</p>
		<h1 class="mb-2 font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-[#1c1c1c]">
			{section.title}
		</h1>
		<p class="m-0 max-w-2xl text-[#6b6b6b]">{section.subtitle}</p>
	</section>

	<div class="mb-5 flex flex-wrap gap-3">
		{
			section.stats.map((stat) => (
				<article class="min-w-[8.5rem] flex-1 rounded-[1.5rem] bg-white px-5 py-4 shadow-[0_18px_40px_rgb(28_28_28_/0.06)]">
					<p class="m-0 text-2xl font-semibold tracking-tight text-[#1c1c1c]">{stat.value}</p>
					<p class="m-0 mt-1 text-xs text-[#6b6b6b]">{stat.label}</p>
				</article>
			))
		}
	</div>

	<section
		class="overflow-hidden rounded-[1.75rem] bg-white shadow-[0_18px_40px_rgb(28_28_28_/0.06)]"
		aria-label={section.title}
	>
		<ul class="m-0 list-none divide-y divide-[#ece8e0] p-0">
			{
				section.rows.map((row) => (
					<li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
						<div class="min-w-0">
							<p class="m-0 text-sm font-semibold text-[#1c1c1c]">{row.title}</p>
							<p class="m-0 text-xs text-[#6b6b6b]">{row.meta}</p>
						</div>
						{row.badge ? (
							<span
								class:list={[
									'inline-flex rounded-full px-3 py-1 text-xs font-medium',
									badgeClass(row.tone),
								]}
							>
								{row.badge}
							</span>
						) : null}
					</li>
				))
			}
		</ul>
	</section>
</div>
