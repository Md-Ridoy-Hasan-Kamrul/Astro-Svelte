---
import StartButton from '../islands/StartButton.svelte';
---

<section id="cta" class="py-[clamp(3.5rem,8vw,6rem)]" aria-labelledby="cta-title">
	<div
		class="mx-auto flex w-[min(100%-2rem,72rem)] flex-wrap items-end justify-between gap-7 rounded-lg border border-line bg-[linear-gradient(135deg,rgb(26_107_115/0.1),transparent_50%),var(--color-paper)] p-[clamp(1.75rem,4vw,2.5rem)]"
	>
		<div>
			<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
				Get started
			</p>
			<h2
				id="cta-title"
				class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
			>
				Ready to mix Astro and Svelte?
			</h2>
			<p class="m-0 max-w-xl text-lg text-ink-soft">
				Import a Svelte component into an Astro page and hydrate it with the matching
				<code class="rounded bg-foam/70 px-1.5 py-0.5 text-[0.95em]">client:*</code> directive —
				<code class="rounded bg-foam/70 px-1.5 py-0.5 text-[0.95em]">load</code> above the fold,
				<code class="rounded bg-foam/70 px-1.5 py-0.5 text-[0.95em]">visible</code> /
				<code class="rounded bg-foam/70 px-1.5 py-0.5 text-[0.95em]">idle</code> below.
			</p>
		</div>
		<StartButton client:idle label="Read framework docs" />
	</div>
</section>
