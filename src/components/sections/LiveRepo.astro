---
import { fetchAstroRepoCached } from '../../lib/api/github';
import { getAxiosErrorMessage } from '../../lib/api/axios';
import type { RepoInfo } from '../../lib/api/github';

let repo: RepoInfo | null = null;
let error: string | null = null;

try {
	repo = await fetchAstroRepoCached();
	if (Astro.cache?.enabled) {
		Astro.cache.set({
			maxAge: 300,
			swr: 60,
			tags: ['github', 'astro-repo'],
		});
	}
} catch (cause) {
	error = getAxiosErrorMessage(cause);
	Astro.logger?.error(`Live GitHub fetch failed: ${error}`);
}
---

<section id="live-repo" class="py-[clamp(3.5rem,8vw,6rem)]" aria-labelledby="live-repo-title">
	<div
		class="mx-auto w-[min(100%-2rem,72rem)] rounded-lg border border-line bg-paper p-[clamp(1.25rem,3vw,1.75rem)]"
	>
		<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
			Server island
		</p>
		<h2
			id="live-repo-title"
			class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
		>
			Live GitHub snapshot
		</h2>
		{
			error ? (
				<p class="m-0 text-accent" role="alert">
					<i class="las la-exclamation-triangle" aria-hidden="true" />
					Could not load live stats. {error}
				</p>
			) : repo ? (
				<p class="m-0 max-w-xl text-lg text-ink-soft">
					<strong class="text-ink">{repo.full_name}</strong>
					{' · '}
					★ {repo.stargazers_count.toLocaleString()} stars
					{repo.language ? (
						<>
							{' · '}
							{repo.language}
						</>
					) : null}
				</p>
			) : null
		}
	</div>
</section>
