---
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero.jpg';
import LiquidGlassButton from '../ui/LiquidGlassButton.svelte';
---

<section
	id="top"
	class="relative isolate grid min-h-[min(92vh,56rem)] items-end overflow-hidden text-hero"
	aria-labelledby="hero-brand"
>
	<div class="absolute inset-0 -z-10" aria-hidden="true">
		<Image
			src={heroImage}
			alt=""
			widths={[640, 960, 1280, 1800]}
			sizes="100vw"
			format="webp"
			quality={75}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover object-[center_35%] motion-safe:[animation:drift_8s_ease-in-out_infinite_alternate]"
		/>
		<div
			class="absolute inset-0 bg-[linear-gradient(180deg,rgb(15_69_76/0.35)_0%,rgb(20_33_43/0.78)_58%,rgb(20_33_43/0.92)_100%),linear-gradient(90deg,rgb(20_33_43/0.55),transparent_55%)]"
		>
		</div>
	</div>

	<div
		class="mx-auto w-[min(100%-2rem,72rem)] max-w-xl py-[clamp(5rem,14vw,8rem)_clamp(3rem,8vw,5rem)] motion-safe:[animation:rise_700ms_ease_both]"
	>
		<p
			id="hero-brand"
			class="mb-3 font-display text-[clamp(1.75rem,5vw,2.75rem)] font-extrabold leading-none tracking-tight text-blue-300"
		>
			Astro Svelte
		</p>
		<h1
			class="mb-4 font-display text-[clamp(1.35rem,3.2vw,2rem)] font-semibold leading-snug tracking-tight text-hero-soft"
		>
			Static <span class="text-blue-300">speed</span>. Interactive <span class="text-blue-300">islands</span>.
		</h1>
		<p class="mb-7 max-w-md text-[1.1rem] text-hero/85">
			Build the page in Astro, hydrate only what needs to move with Svelte.
		</p>
		<div class="flex flex-wrap gap-3">
			<LiquidGlassButton href="#cta" label="Start building" surface="light" />
			<LiquidGlassButton href="#features" label="See features" surface="dark" />
		</div>
	</div>
</section>
