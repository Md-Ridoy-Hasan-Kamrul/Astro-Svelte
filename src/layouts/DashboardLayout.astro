---
/**
 * Crextio dashboard chrome — separate from landing Layout/Navbar.
 */
import '../styles/global.css';
import '@fontsource-variable/figtree';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';

interface Props {
	title?: string;
}

const { title = 'Crextio Dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en" class="overflow-x-clip">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Crextio HR dashboard — admin demo." />
		<title>{title}</title>
		<style is:global>
			:root {
				--cx-bg0: #f3f1ea;
				--cx-bg1: #fff8e0;
				--cx-ink: #1c1c1c;
				--cx-muted: #6b6b6b;
				--cx-yellow: #ffd74b;
				--cx-yellow-deep: #f0c83a;
				--cx-card: #ffffff;
				--cx-soft: #f0eee8;
				--cx-stripe: #e6e3db;
				--cx-radius: 1.75rem;
				--cx-radius-sm: 1.15rem;
				--cx-shadow: 0 18px 40px rgb(28 28 28 / 0.06);
			}

			body.crextio {
				min-height: 100svh;
				margin: 0;
				color: var(--cx-ink);
				font-family: var(--font-body);
				background:
					radial-gradient(90% 70% at 0% 0%, #eef1f5 0%, transparent 55%),
					radial-gradient(80% 60% at 100% 100%, var(--cx-bg1) 0%, transparent 50%),
					linear-gradient(160deg, var(--cx-bg0), #faf7ef 45%, var(--cx-bg1));
				cursor: var(--cursor-site-default);
			}
		</style>
	</head>
	<body class="crextio overflow-x-clip">
		<slot />
	</body>
</html>
