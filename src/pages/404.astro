---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.svelte';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Page not found — Astro Svelte" description="This page does not exist.">
	<Navbar client:media="(max-width: 720px)" />
	<main id="main" class="mx-auto w-[min(100%-2rem,40rem)] py-[clamp(4rem,12vw,7rem)]">
		<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">404</p>
		<h1 class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold text-ink">
			Page not found
		</h1>
		<p class="mb-6 text-lg text-ink-soft">
			That route is not in this project. Head home or open About.
		</p>
		<div class="flex flex-wrap gap-3">
			<a
				href="/"
				class="inline-flex min-h-11 items-center rounded-[0.35rem] bg-sea px-5 font-bold text-paper no-underline"
			>
				Home
			</a>
			<a
				href="/about"
				class="inline-flex min-h-11 items-center rounded-[0.35rem] border border-line px-5 font-bold text-ink no-underline"
			>
				About
			</a>
		</div>
	</main>
	<Footer />
</Layout>
