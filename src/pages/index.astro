---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.svelte';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import LiveRepo from '../components/sections/LiveRepo.astro';
import StackDemo from '../components/islands/StackDemo.svelte';
import CallToAction from '../components/sections/CallToAction.astro';
import Footer from '../components/layout/Footer.astro';
import ToastHost from '../components/islands/ToastHost.svelte';
---

<Layout title="Astro Svelte — Landing">
	<Navbar client:media="(max-width: 720px)" />
	<ToastHost client:idle />
	<main id="main">
		<Hero />
		<Features />
		<HowItWorks />
		<LiveRepo server:defer>
			<section
				id="live-repo"
				class="py-[clamp(3.5rem,8vw,6rem)]"
				slot="fallback"
				aria-busy="true"
			>
				<div class="mx-auto w-[min(100%-2rem,72rem)]">
					<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
						Server island
					</p>
					<h2
						class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
					>
						Live GitHub snapshot
					</h2>
					<p class="m-0 max-w-xl text-lg text-ink-soft">Loading live stats…</p>
				</div>
			</section>
		</LiveRepo>
		<StackDemo client:visible />
		<CallToAction />
	</main>
	<Footer />
</Layout>
