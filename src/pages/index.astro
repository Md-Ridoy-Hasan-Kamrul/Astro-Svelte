---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.svelte';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import LiveRepo from '../components/sections/LiveRepo.astro';
import StackDemo from '../components/islands/StackDemo.svelte';
import CallToAction from '../components/sections/CallToAction.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Astro Svelte — Landing">
	<Navbar client:load />
	<main>
		<Hero />
		<Features />
		<HowItWorks />
		<LiveRepo server:defer>
			<section class="section" id="live-repo" slot="fallback" aria-busy="true">
				<div class="container">
					<p class="section__eyebrow">Server island</p>
					<h2 class="section__title">Live GitHub snapshot</h2>
					<p class="section__lede">Loading live stats…</p>
				</div>
			</section>
		</LiveRepo>
		<StackDemo client:visible />
		<CallToAction />
	</main>
	<Footer />
</Layout>
